[Unit]
Description=Home Desktop Clock Widget for Hyprland (Workspace 1)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/fuckwindows/.config/hypr/scripts/home_clock.py
ExecReload=/bin/kill -SIGUSR1 $MAINPID
Restart=always
RestartSec=1
Environment=PATH=/home/fuckwindows/.local/bin:/usr/local/bin:/usr/bin
Environment=XDG_CURRENT_DESKTOP=Hyprland

[Install]
WantedBy=default.target
