{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/home/fuckwindows/.config/fastfetch/garuda_dragon.png",
        "width": 30,
        "padding": {
            "left": 4,
            "top": 3
        }
    },
    "display": {
        "separator": " \u001b[31m⮕⮞\u001b[0m "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "╭─➤  Operating System ⮜─────────────────────────────────────────────╮",
            "outputColor": "31"
        },
        {
            "type": "custom",
            "format": "╰─┬──────────────────────────────────────────────────────────────────╯",
            "outputColor": "31"
        },
        {
            "type": "os",
            "key": "\u001b[32m│  │\u001b[0m",
            "format": "{pretty-name} {codename}"
        },
        {
            "type": "de",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "kernel",
            "key": "\u001b[32m│  │\u001b[0m",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "\u001b[32m│  │\u001b[0m",
            "keyColor": "cyan"
        },
        {
            "type": "shell",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "wm",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "lm",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "wmtheme",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "theme",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "font",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "cpu",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "gpu",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "display",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "memory",
            "key": "\u001b[32m│  │\u001b[0m",
            "keyColor": "white"
        },
        {
            "type": "disk",
            "key": "\u001b[32m│  │\u001b[0m"
        },
        {
            "type": "custom",
            "format": "╭───────➤ 𓆩☠︎︎𓆪 ⮜──────────────────────────────────────────────────────╮",
            "outputColor": "31"
        },
        {
            "type": "custom",
            "format": "╰────────────────────────────────────────────────────────────────────╯",
            "outputColor": "31"
        }
    ]
}